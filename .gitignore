/.env

# Python Build & Virtual Environments
.venv/
__pycache__/
*.pyc

# Test and coverage artefacts
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Heavy Data or IDE directories
.idea/
.vscode/

# ignore pdf and other additional learning files
*.pdf

# Generated run artefacts. The archive under results/runs/ is machine-written,
# UUID-named and unbounded - every local run would otherwise land in the diff -
# and results/logs/ is the same. The curated sample runs under results/samples/
# are an assignment deliverable and stay tracked.

results/*
!results/samples/

# Local assistant / tooling working files - not part of the deliverable
CLAUDE.md
INTERVIEW_PREP.md
.claude/
.cursor/
.cursorrules
.aider*
.github/copilot-instructions.md
AGENTS.md
.mcp.json
